{
  "name": "integration-server-interview",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/guiyomh/features/just:0": {}
  },
  // Codespaces waits for onCreateCommand before opening the editor, so the
  // dependencies are installed before anyone can run the script.
  "onCreateCommand": "just setup && for rc in ~/.bashrc ~/.zshrc; do echo 'source ${containerWorkspaceFolder}/.venv/bin/activate' >> \"$rc\"; done",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": ["ms-python.python"]
    }
  }
}
